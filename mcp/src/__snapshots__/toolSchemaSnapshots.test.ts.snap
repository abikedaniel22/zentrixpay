          "title",
          "amount",
          "currency",
          "network",
          "purchasedAt",
          "txHash",
          "receiptRef",
          "explorerUrl",
        ],
        "type": "object",
      },
      "type": "array",
    },
    "schema": {
      "const": "zentrixpay.receipt-export/v1",
      "type": "string",
    },
    "totalAmount": {
      "description": "Sum of the exported amounts as a decimal string.",
      "type": "string",
    },
  },
  "required": [
    "schema",
    "generatedAt",
    "format",
    "filters",
    "count",
    "totalAmount",
    "currency",
    "receipts",
  ],
  "type": "object",
}
`;

