exports[`tool schema snapshots > zentrixpay_metrics > input schema 1`] = `
{
  "properties": {
    "format": {
      "default": "json",
      "description": "Metrics export format. json (default) returns the snapshot object; otlp returns the same data as an OTLP/JSON ExportMetricsServiceRequest payload (a resourceMetrics envelope ready for an OpenTelemetry collector).",
      "enum": [
        "json",
        "otlp",
      ],
      "examples": [
        "json",
        "otlp",
      ],
      "type": "string",
    },
    "reset": {
      "description": "Clear all counters after returning the current snapshot (default: false leaves counters intact). Example: true resets metrics after reading.",
      "examples": [
        true,
        false,
      ],
      "type": "boolean",
    },
  },
  "required": [],
  "type": "object",
}
`;

