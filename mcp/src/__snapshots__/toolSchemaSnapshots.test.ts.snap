            "type": "string",
          },
          "explorerUrl": {
            "type": [
              "string",
              "null",
            ],
          },
          "network": {
            "type": "string",
          },
          "purchasedAt": {
            "type": "string",
          },
          "receiptRef": {
            "type": [
              "string",
              "null",
            ],
          },
          "resourceId": {
            "type": "string",
          },
          "title": {
            "type": [
              "string",
              "null",
            ],
          },
          "txHash": {
            "type": [
