        "limit",
        "groupBy",
      ],
      "type": "object",
    },
    "format": {
      "enum": [
        "json",
        "csv",
        "ndjson",
      ],
      "type": "string",
    },
    "generatedAt": {
      "description": "ISO-8601 instant the export was produced.",
      "type": "string",
    },
